NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Postgres connection string from Supabase Dashboard > Connect.
# Percent-encode special characters in the database password.
SUPABASE_DB_URL=postgresql://postgres.project-ref:password@host:5432/postgres
